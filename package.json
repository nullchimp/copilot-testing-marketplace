{
  "name": "testing-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.18" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node --test tests/browser/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "check:sdk": "node scripts/check-sdk.mjs",
    "check:runtime": "node --experimental-default-type=module scripts/check-runtime.mjs",
    "fixture:playwright": "node scripts/generate-playwright-fixture.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.11.1",
    "typescript": "5.9.3"
  }
}
